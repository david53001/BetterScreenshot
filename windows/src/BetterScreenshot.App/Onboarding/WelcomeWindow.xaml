<Window x:Class="BetterScreenshot.App.Onboarding.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to BetterScreenshot"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF9F9FB" FontFamily="Segoe UI">
    <StackPanel Margin="36,32,36,28">

        <!-- App icon: charcoal rounded square with a white camera glyph (hand-authored vector) -->
        <Border Width="72" Height="72" CornerRadius="16" Background="#1C1C1C" HorizontalAlignment="Center">
            <Canvas Width="72" Height="72">
                <Rectangle Canvas.Left="30" Canvas.Top="20" Width="12" Height="6" RadiusX="2" RadiusY="2" Fill="#F5F5F5"/>
                <Border Canvas.Left="18" Canvas.Top="26" Width="36" Height="26" CornerRadius="6" Background="#F5F5F5"/>
                <Ellipse Canvas.Left="28" Canvas.Top="31" Width="16" Height="16" Fill="#1C1C1C"/>
            </Canvas>
        </Border>

        <TextBlock Text="Welcome to BetterScreenshot" FontSize="19" FontWeight="Bold"
                   Margin="0,18,0,0" HorizontalAlignment="Center"/>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#666" Margin="0,8,0,0"
                   Text="A free, 100% local screenshot &amp; recording tool that lives in your system tray — no cloud, no accounts."/>

        <Border Background="#FFEFEFF3" CornerRadius="10" Margin="0,18,0,0" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Ctrl+Shift+4" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock Grid.Column="1" Text="Capture an area" Foreground="#555"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Ctrl+Shift+5" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock Grid.Column="1" Text="Record the screen" Foreground="#555"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Ctrl+Shift+6" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock Grid.Column="1" Text="Capture the full screen" Foreground="#555"/>
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Ctrl+Shift+8" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock Grid.Column="1" Text="Capture a window" Foreground="#555"/>
                </Grid>
            </StackPanel>
        </Border>

        <Button Content="Start Capturing" IsDefault="True" Click="Start_Click"
                Margin="0,20,0,0" Padding="0,9" FontSize="14" Foreground="White"
                Background="#0A84FF" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
</Window>
