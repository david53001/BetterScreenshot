<Window x:Class="BetterScreenshot.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterScreenshot Settings"
        Width="520" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#FFF7F7FA" FontFamily="Segoe UI">
    <DockPanel Margin="0">
        <Border DockPanel.Dock="Bottom" BorderBrush="#FFE1E1E6" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Content="Cancel" Width="90" Padding="0,6" Click="Cancel_Click"/>
                <Button x:Name="SaveBtn" Content="Save" Width="90" Padding="0,6" Margin="10,0,0,0"
                        IsDefault="True" Click="Save_Click" Background="#0A84FF" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <TabControl Margin="12">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="After capture:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AfterCaptureCombo" Width="240">
                                <ComboBoxItem Content="Show Quick Access overlay"/>
                                <ComboBoxItem Content="Copy to clipboard"/>
                                <ComboBoxItem Content="Save to folder"/>
                                <ComboBoxItem Content="Copy and save"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Image format:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FormatCombo" Width="120">
                                <ComboBoxItem Content="PNG"/>
                                <ComboBoxItem Content="JPG"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Overlay corner:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CornerCombo" Width="160">
                                <ComboBoxItem Content="Top Left"/>
                                <ComboBoxItem Content="Top Right"/>
                                <ComboBoxItem Content="Bottom Left"/>
                                <ComboBoxItem Content="Bottom Right"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Overlay auto-dismiss:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AutoDismissCombo" Width="120">
                                <ComboBoxItem Content="3 seconds"/>
                                <ComboBoxItem Content="6 seconds"/>
                                <ComboBoxItem Content="10 seconds"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Save folder:" Width="150" VerticalAlignment="Center"/>
                            <TextBox x:Name="SaveDirBox" Width="230" VerticalContentAlignment="Center"/>
                            <Button x:Name="BrowseBtn" Content="Browse…" Margin="8,0,0,0" Padding="8,2" Click="Browse_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Pin corner radius:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PinRadiusCombo" Width="90">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="20"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="PinShadowCheck" Content="Pin drop shadow" Margin="0,8"/>
                        <CheckBox x:Name="HistoryEnabledCheck" Content="Remember capture history" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="History limit:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="HistoryCapCombo" Width="90">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="200"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="LaunchAtLoginCheck" Content="Launch at login" Margin="0,4"/>
                        <CheckBox x:Name="CaptureSoundCheck" Content="Play a sound on capture" Margin="0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ShortcutsPanel" Margin="14"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Recording">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Format:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="RecFormatCombo" Width="120">
                                <ComboBoxItem Content="MP4"/>
                                <ComboBoxItem Content="GIF"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Frame rate:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="FpsCombo" Width="120">
                                <ComboBoxItem Content="30 fps"/>
                                <ComboBoxItem Content="60 fps"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="SysAudioCheck" Content="Record system audio" Margin="0,6"/>
                        <CheckBox x:Name="MicCheck" Content="Record microphone" Margin="0,4"/>
                        <CheckBox x:Name="CameraCheck" Content="Show camera bubble" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Camera size:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CameraSizeCombo" Width="120">
                                <ComboBoxItem Content="Small"/>
                                <ComboBoxItem Content="Medium"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="ClicksCheck" Content="Highlight mouse clicks" Margin="0,4"/>
                        <CheckBox x:Name="KeystrokesCheck" Content="Show keystrokes" Margin="0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <TextBlock Text="Countdown:" Width="150" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CountdownCombo" Width="120">
                                <ComboBoxItem Content="Off"/>
                                <ComboBoxItem Content="3 seconds"/>
                                <ComboBoxItem Content="5 seconds"/>
                                <ComboBoxItem Content="10 seconds"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
