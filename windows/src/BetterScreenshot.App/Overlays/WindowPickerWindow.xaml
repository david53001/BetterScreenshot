<Window x:Class="BetterScreenshot.App.Overlays.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#26000000"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual" Cursor="Cross">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Rectangle x:Name="Highlight" Visibility="Collapsed"/>
        <Border x:Name="TitleHost" Background="#99000000" CornerRadius="4" Padding="6,3" Visibility="Collapsed">
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
    </Canvas>
</Window>
