<Window x:Class="BetterScreenshot.App.Overlays.SelectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="#59000000" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Cursor="Cross" ShowActivated="True">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <Rectangle x:Name="SelRect" Stroke="White" StrokeThickness="1" Visibility="Collapsed"/>
        <Border x:Name="DimLabelHost" Background="#CC1C1C1C" CornerRadius="3" Padding="6,2" Visibility="Collapsed">
            <TextBlock x:Name="DimLabel" Foreground="White" FontSize="12" FontWeight="Medium"/>
        </Border>
    </Canvas>
</Window>
