<Window x:Class="BetterScreenshot.App.Overlays.QuickAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Width="220" Height="184" WindowStartupLocation="Manual">
    <Border x:Name="Card" CornerRadius="12" Background="{StaticResource Theme.CardBrush}"
            BorderBrush="{StaticResource Theme.BorderBrush}" BorderThickness="1" Margin="6" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <!-- DockPanel keeps the button row and the thumbnail in separate bands so the buttons'
             hover pills can never overlap (bleed into) the image; the 8px top margin is the gap. -->
        <DockPanel LastChildFill="True">
            <StackPanel x:Name="ButtonRow" DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <Border CornerRadius="6" ClipToBounds="True" Background="#14FFFFFF">
                <Image x:Name="Thumb" Stretch="Uniform"/>
            </Border>
        </DockPanel>
    </Border>
</Window>
