<Window x:Class="BetterScreenshot.App.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History" Width="720" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#FF2B2B2E">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF232326" Padding="10,8">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="CountLabel" DockPanel.Dock="Left" Foreground="#FFB0B0B5"
                           VerticalAlignment="Center" Margin="2,0,10,0"/>
                <Button x:Name="ClearAllButton" DockPanel.Dock="Left" Content="Clear All…"
                        Click="ClearAll_Click" Padding="10,5"/>
                <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete"
                        Click="Delete_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="RevealButton" DockPanel.Dock="Right" Content="Show in Explorer"
                        Click="Reveal_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="PinButton" DockPanel.Dock="Right" Content="Pin"
                        Click="Pin_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="AnnotateButton" DockPanel.Dock="Right" Content="Annotate"
                        Click="Annotate_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy"
                        Click="Copy_Click" Padding="10,5" Margin="6,0,0,0"/>
            </DockPanel>
        </Border>
        <Grid>
            <TextBlock x:Name="EmptyLabel" Text="No captures yet" FontSize="18" Foreground="#FF7A7A80"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12">
                <WrapPanel x:Name="CellsPanel" Orientation="Horizontal"/>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
